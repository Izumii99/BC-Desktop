<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Bondage Club</AssemblyName>
    <RootNamespace>BCDesktop</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>BC Desktop</Product>
    <AssemblyTitle>BC Desktop</AssemblyTitle>
    <Company>BC Client</Company>
    <Authors>Izumii99</Authors>
    <Description>Bondage Club Desktop Client for Windows</Description>
    <RepositoryUrl>https://github.com/Izumii99/BC-Desktop</RepositoryUrl>
    <PackageTags>bondage-club;bc-desktop;game;client</PackageTags>
    <Version>7.3.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DefaultItemExcludes>$(DefaultItemExcludes);platform\**;references\**;_references\**;tools\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*.png" />
    <Resource Include="Assets\**\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <None Remove="Scripts\**\*" />
    <EmbeddedResource Include="loader.user.js" LogicalName="BuiltInLoader.js" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BCDesktop.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>


