<Window x:Class="BCDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Bondage Club"
        Height="608" Width="1152"
        MinHeight="212" MinWidth="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico">

    <Window.Resources>
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1affffff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#c42b1c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#992115"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder" Background="#0d0d0d" BorderBrush="#2b2b2b" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="#1a1a1a"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  MouseMove="TitleBar_MouseMove"
                  MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                  MouseRightButtonUp="TitleBar_MouseRightButtonUp">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="Assets/app_logo.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleLabel"
                           Text="Bondage Club"
                           Foreground="#dddddd"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           MouseLeftButtonUp="TitleLabel_MouseLeftButtonUp"/>
                <Border x:Name="VersionBadge"
                        Background="#252230"
                        BorderBrush="#443b59"
                        BorderThickness="1"
                        CornerRadius="9"
                        Margin="8,0,0,0"
                        Padding="7,1,7,1"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Version 7.5.1&#x0a;Click to view release notes"
                        MouseLeftButtonUp="VersionBadge_MouseLeftButtonUp">
                    <TextBlock x:Name="VersionBadgeText"
                               Text="v7.5.1"
                               Foreground="#bda6e8"
                               FontSize="10"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="UpdateBadge"
                        Visibility="Collapsed"
                        Background="#2d1b4e"
                        BorderBrush="#a855f7"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="8,0,0,0"
                        Padding="6,1,6,1"
                        Cursor="Hand"
                        MouseLeftButtonUp="UpdateBadge_MouseLeftButtonUp"
                        MouseRightButtonUp="UpdateBadge_MouseRightButtonUp">
                    <TextBlock x:Name="UpdateBadgeText"
                               Text="Update"
                               Foreground="#d8b4fe"
                               FontSize="10"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource TitleBtn}" Click="MinimizeBtn_Click"
                        ToolTip="Minimize" Content="&#xE921;"/>
                <Button Style="{StaticResource TitleBtn}" Click="MaxRestoreBtn_Click"
                        x:Name="MaxRestoreBtn"
                        ToolTip="Maximize" Content="&#xE922;"/>
                <Button Style="{StaticResource CloseTitleBtn}" Click="CloseBtn_Click"
                        ToolTip="Close" Content="&#xE8BB;"/>
            </StackPanel>
        </Grid>

        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"
                      Margin="5,0,5,5"
                      CoreWebView2InitializationCompleted="WebView_Initialized"/>
        </Grid>
    </Border>
</Window>


