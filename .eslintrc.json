{
  "$schema": "https://json.schemastore.org/eslintrc.json",
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "globals": {
    "Player": "readonly",
    "CurrentCharacter": "readonly",
    "Character": "readonly",
    "ChatRoomCharacter": "readonly",
    "ChatRoomData": "readonly",
    "ChatRoomTargetAvatar": "readonly",
    "ChatRoomMessage": "readonly",
    "ChatRoomCharacterItemUpdate": "readonly",
    "CurrentScreen": "readonly",
    "ServerSend": "readonly",
    "ServerListener": "readonly",
    "ServerAccountUpdate": "readonly",
    "ServerPlayerInventorySync": "readonly",
    "DrawButton": "readonly",
    "DrawRect": "readonly",
    "DrawText": "readonly",
    "DrawEmptyRect": "readonly",
    "DrawImage": "readonly",
    "MouseIn": "readonly",
    "MouseX": "readonly",
    "MouseY": "readonly",
    "ElementCreate": "readonly",
    "ElementPosition": "readonly",
    "ElementRemove": "readonly",
    "ElementValue": "readonly",
    "ElementScrollToEnd": "readonly",
    "DialogLeave": "readonly",
    "DialogInventory": "readonly",
    "DialogItemClick": "readonly",
    "DialogMenuButton": "readonly",
    "DialogSelfMenuClick": "readonly",
    "DialogActivity": "readonly",
    "InventoryGet": "readonly",
    "InventoryAdd": "readonly",
    "InventoryRemove": "readonly",
    "InventoryUnlock": "readonly",
    "InventoryWear": "readonly",
    "InventoryGroupIsBlocked": "readonly",
    "InventoryPrerequisiteMessage": "readonly",
    "AssetFemale3DCG": "readonly",
    "StruggleProgress": "readonly",
    "Preference": "readonly",
    "MainCanvas": "readonly",
    "BCX": "readonly",
    "BCX_Version": "readonly",
    "BC_QoL": "readonly",
    "BC_ChatQoL": "readonly",
    "chrome": "readonly",
    "GM_info": "readonly",
    "GM_xmlhttpRequest": "readonly",
    "GM_setValue": "readonly",
    "GM_getValue": "readonly",
    "unsafeWindow": "readonly"
  },
  "rules": {
    "no-undef": "off",
    "no-prototype-builtins": "off",
    "no-inner-declarations": "off",
    "security/detect-object-injection": "off",
    "security/detect-non-literal-fs-filename": "off",
    "security/detect-non-literal-regexp": "off",
    "security/detect-unsafe-regex": "off",
    "security/detect-child-process": "off",
    "security/detect-eval-with-expression": "off",
    "security/detect-no-csrf-before-method-override": "off",
    "security/detect-possible-timing-attacks": "off",
    "security/detect-pseudoRandomBytes": "off",
    "no-unsanitized/method": "off",
    "no-unsanitized/property": "off"
  }
}
