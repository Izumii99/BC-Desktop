# Top-most EditorConfig file
root = true

[*.cs]
# S2696 / S3010: Intentional static fallback cache variables
dotnet_diagnostic.S2696.severity = none
dotnet_diagnostic.S3010.severity = none

# S2223: Non-constant fields visibility
dotnet_diagnostic.S2223.severity = none

# S2486 / S108: Graceful fallback error handling
dotnet_diagnostic.S2486.severity = none
dotnet_diagnostic.S108.severity = none

# S6444: Regex execution timeout specification in desktop environment
dotnet_diagnostic.S6444.severity = none

# S1854: Unused assignments to local variables
dotnet_diagnostic.S1854.severity = none


